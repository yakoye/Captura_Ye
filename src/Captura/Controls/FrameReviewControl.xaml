<UserControl x:Class="Captura.FrameReviewControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 AllowDrop="True" Drop="Media_Drop" PreviewDragOver="Media_DragOver"
 Focusable="True" PreviewKeyDown="Review_KeyDown" FontFamily="Microsoft YaHei UI" FontSize="13">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="PlayerIcons.xaml"/></ResourceDictionary.MergedDictionaries>
  <Style x:Key="ReviewButton" TargetType="Button">
   <Setter Property="Foreground" Value="{DynamicResource ItemText}"/>
   <Setter Property="Background" Value="{DynamicResource WindowBackground}"/>
   <Setter Property="BorderBrush" Value="#4064748B"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="10,5"/><Setter Property="MinHeight" Value="30"/>
   <Setter Property="Focusable" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#203B82F6"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Button" BasedOn="{StaticResource ReviewButton}"/>
  <Style x:Key="FrameEditButton" TargetType="Button" BasedOn="{StaticResource ReviewButton}">
   <Setter Property="FontSize" Value="11"/><Setter Property="MinHeight" Value="24"/>
   <Setter Property="Padding" Value="6,2"/><Setter Property="Margin" Value="4,0,0,0"/>
  </Style>
  <Style x:Key="TransportButton" TargetType="Button" BasedOn="{StaticResource ReviewButton}">
   <Setter Property="Width" Value="34"/><Setter Property="Height" Value="42"/>
   <Setter Property="Padding" Value="5,3"/><Setter Property="Margin" Value="0,0,2,0"/>
   <Setter Property="ToolTipService.InitialShowDelay" Value="200"/>
   <Setter Property="ToolTipService.ShowDuration" Value="20000"/>
  </Style>
  <Style x:Key="RepeatReviewButton" TargetType="RepeatButton">
   <Setter Property="Delay" Value="350"/><Setter Property="Interval" Value="110"/>
   <Setter Property="Foreground" Value="{DynamicResource ItemText}"/>
   <Setter Property="Background" Value="{DynamicResource WindowBackground}"/>
   <Setter Property="BorderBrush" Value="#4064748B"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="10,5"/><Setter Property="MinHeight" Value="30"/>
   <Setter Property="Focusable" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton">
    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#203B82F6"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="RepeatTransportButton" TargetType="RepeatButton" BasedOn="{StaticResource RepeatReviewButton}">
   <Setter Property="Width" Value="34"/><Setter Property="Height" Value="42"/>
   <Setter Property="Padding" Value="5,3"/><Setter Property="Margin" Value="0,0,2,0"/>
   <Setter Property="ToolTipService.InitialShowDelay" Value="200"/>
   <Setter Property="ToolTipService.ShowDuration" Value="20000"/>
  </Style>
  <Style x:Key="TransportIcon" TargetType="Path">
   <Setter Property="Width" Value="22"/><Setter Property="Height" Value="22"/><Setter Property="Stretch" Value="Uniform"/>
   <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"/>
  </Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource ItemText}"/></Style>
  <Style x:Key="ZoomButton" TargetType="Button" BasedOn="{StaticResource ReviewButton}">
   <Setter Property="Width" Value="30"/><Setter Property="Height" Value="28"/><Setter Property="MinHeight" Value="28"/>
   <Setter Property="Padding" Value="4"/><Setter Property="Margin" Value="1,0"/>
   <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#243341"/>
   <Setter Property="ToolTipService.InitialShowDelay" Value="200"/>
  </Style>
  </ResourceDictionary>
 </UserControl.Resources>
 <Grid Margin="12,8">
  <Grid.RowDefinitions>
   <RowDefinition Height="*" MinHeight="160"/>
   <RowDefinition Height="6"/><RowDefinition Height="144" MinHeight="144" MaxHeight="260"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <Grid Grid.Row="0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="196"/></Grid.ColumnDefinitions>
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid x:Name="PreviewHost" SizeChanged="PreviewHost_SizeChanged">
    <Border x:Name="PreviewSurface" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#111827" CornerRadius="8" MouseLeftButtonDown="Preview_MouseDown" MouseMove="Preview_MouseMove" MouseLeftButtonUp="Preview_MouseUp"
            LostMouseCapture="Preview_LostCapture" PreviewMouseWheel="Preview_MouseWheel" SizeChanged="Preview_SizeChanged" Focusable="True" ClipToBounds="True">
     <Grid>
     <ScrollViewer x:Name="PreviewViewport" Margin="6" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="False" Focusable="False">
      <Grid x:Name="PreviewCanvas" HorizontalAlignment="Center" VerticalAlignment="Center">
      <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Manual" ScrubbingEnabled="True"
                    MediaOpened="Player_Opened" MediaEnded="Player_Ended" MediaFailed="Player_Failed"/>
      <Image x:Name="Still" Stretch="Uniform"/>
      </Grid>
     </ScrollViewer>
      <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
       <TextBlock Text="将视频或 GIF 拖到这里" Foreground="White" FontSize="20" HorizontalAlignment="Center"/>
       <TextBlock x:Name="EmptyHint" Text="也可点击右上方打开文件，或完成一次录制" Foreground="#CBD5E1" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12"/>
      </StackPanel>
      <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10,10,24,24" Padding="4" Background="#E6111827" CornerRadius="6">
       <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="ZoomOutButton" Style="{StaticResource ZoomButton}" IsEnabled="False" Click="ZoomOut_Click" ToolTip="缩小预览（也可 Ctrl＋鼠标滚轮）" AutomationProperties.Name="缩小预览"><Path Style="{StaticResource TransportIcon}" Data="{StaticResource PlayerIcon-magnify-minus-outline}"/></Button>
        <TextBlock x:Name="ZoomLabel" Text="1×" Foreground="White" FontSize="11" MinWidth="42" TextAlignment="Center" VerticalAlignment="Center" ToolTip="相对于适应窗口的倍率；放大后按住左键拖动画面"/>
        <Button x:Name="ZoomInButton" Style="{StaticResource ZoomButton}" IsEnabled="False" Click="ZoomIn_Click" ToolTip="放大预览（也可 Ctrl＋鼠标滚轮）" AutomationProperties.Name="放大预览"><Path Style="{StaticResource TransportIcon}" Data="{StaticResource PlayerIcon-magnify-plus-outline}"/></Button>
        <Button x:Name="ZoomFitButton" Style="{StaticResource ZoomButton}" Width="48" IsEnabled="False" Content="适应" Click="ZoomFit_Click" ToolTip="恢复适应窗口，重置缩放和位置" AutomationProperties.Name="适应窗口"/>
       </StackPanel>
      </Border>
     </Grid>
    </Border>
    </Grid>
    <StackPanel Grid.Row="1" Margin="0,8,0,0">
     <Slider x:Name="Timeline" Minimum="0" IsMoveToPointEnabled="True" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="Timeline_Changed" ToolTip="拖动定位；查看位置不会清除已选帧" Margin="0,0,0,6"/>
     <DockPanel LastChildFill="True">
      <CheckBox x:Name="FrameMode" Content="逐帧" Checked="Mode_Changed" Unchecked="Mode_Changed" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="开启：左右键逐帧；关闭：左右键沿用最近点击的 1 秒或 5 秒步长"/>
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
       <Button Style="{StaticResource TransportButton}" Click="First_Click" ToolTip="第一帧" AutomationProperties.Name="第一帧">
        <Path Style="{StaticResource TransportIcon}" Data="{StaticResource PlayerIcon-skip-previous}"/>
       </Button>
       <RepeatButton Style="{StaticResource RepeatTransportButton}" Click="BackFive_Click" ToolTip="前5秒" AutomationProperties.Name="前5秒">
        <StackPanel><Path Style="{StaticResource TransportIcon}" Data="{StaticResource PlayerIcon-rewind}"/><TextBlock Text="5秒" FontSize="9" HorizontalAlignment="Center"/></StackPanel>
       </RepeatButton>
       <RepeatButton Style="{StaticResource RepeatTransportButton}" Click="BackOne_Click" ToolTip="前1秒" AutomationProperties.Name="前1秒">
        <StackPanel><Path Style="{StaticResource TransportIcon}" Data="{StaticResource PlayerIcon-rewind}"/><TextBlock Text="1秒" FontSize="9" HorizontalAlignment="Center"/></StackPanel>
       </RepeatButton>
       <RepeatButton x:Name="PreviousButton" Style="{StaticResource RepeatTransportButton}" Click="Previous_Click" ToolTip="上一帧" AutomationProperties.Name="上一帧">
        <StackPanel><Path Style="{StaticResource TransportIcon}" Data="{StaticResource PlayerIcon-step-backward}"/><TextBlock Text="1帧" FontSize="9" HorizontalAlignment="Center"/></StackPanel>
       </RepeatButton>
       <Button x:Name="PlayButton" Style="{StaticResource TransportButton}" Click="Play_Click" ToolTip="播放（空格）" AutomationProperties.Name="播放">
        <Path x:Name="PlayGlyph" Style="{StaticResource TransportIcon}" Data="{StaticResource PlayerIcon-play}"/>
       </Button>
       <RepeatButton x:Name="NextButton" Style="{StaticResource RepeatTransportButton}" Click="Next_Click" ToolTip="下一帧" AutomationProperties.Name="下一帧">
        <StackPanel><Path Style="{StaticResource TransportIcon}" Data="{StaticResource PlayerIcon-step-forward}"/><TextBlock Text="1帧" FontSize="9" HorizontalAlignment="Center"/></StackPanel>
       </RepeatButton>
       <RepeatButton Style="{StaticResource RepeatTransportButton}" Click="ForwardOne_Click" ToolTip="后1秒" AutomationProperties.Name="后1秒">
        <StackPanel><Path Style="{StaticResource TransportIcon}" Data="{StaticResource PlayerIcon-fast-forward}"/><TextBlock Text="1秒" FontSize="9" HorizontalAlignment="Center"/></StackPanel>
       </RepeatButton>
       <RepeatButton Style="{StaticResource RepeatTransportButton}" Click="ForwardFive_Click" ToolTip="后5秒" AutomationProperties.Name="后5秒">
        <StackPanel><Path Style="{StaticResource TransportIcon}" Data="{StaticResource PlayerIcon-fast-forward}"/><TextBlock Text="5秒" FontSize="9" HorizontalAlignment="Center"/></StackPanel>
       </RepeatButton>
       <Button Style="{StaticResource TransportButton}" Click="Last_Click" ToolTip="最后一帧" AutomationProperties.Name="最后一帧">
        <Path Style="{StaticResource TransportIcon}" Data="{StaticResource PlayerIcon-skip-next}"/>
       </Button>
      </StackPanel>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0" ToolTip="帧号；当前时间 / 总时间">
       <TextBlock x:Name="FrameNumberLabel" Text="0 / 0 帧" FontSize="10"/>
       <TextBlock Text=" · " FontSize="10" Opacity="0.6"/>
       <TextBlock x:Name="PositionLabel" Text="00:00:00.000 / 00:00:00.000" FontSize="10"/>
      </StackPanel>
     </DockPanel>
    </StackPanel>
   </Grid>
   <Grid x:Name="ExportSidebar" Grid.Column="2">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Margin="4,0,4,8">
   <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
    <Button Content="打开媒体" Click="Open_Click" FontSize="11" Padding="5,4" MinHeight="28" ToolTip="打开视频或 GIF"/>
    <Button Content="实时画面" Click="Live_Click" FontSize="11" Padding="5,4" MinHeight="28" Margin="4,0,0,0"/>
    <Button x:Name="HelpButton" Click="Help_Click" Margin="4,0,0,0" Padding="3" MinHeight="28" Width="28" ToolTip="回看与选帧帮助" AutomationProperties.Name="回看与选帧帮助">
     <Path Style="{StaticResource TransportIcon}" Data="{StaticResource PlayerIcon-help-circle-outline}"/>
    </Button>
    <Popup x:Name="ReviewHelp" PlacementTarget="{Binding ElementName=HelpButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
     <Border Background="{DynamicResource WindowBackground}" BorderBrush="#8064748B" BorderThickness="1" CornerRadius="8" Padding="16" Width="380" Margin="0,6,0,0">
      <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto"><StackPanel>
       <DockPanel Margin="0,0,0,12"><Button Content="关闭" Click="HelpClose_Click" DockPanel.Dock="Right" Padding="6,2"/><TextBlock Text="回看与选帧帮助" FontSize="16" FontWeight="SemiBold"/></DockPanel>
       <TextBlock Text="长视频先打开预览，精确索引在后台建立；完成前可播放和定位，选帧编辑及导出在索引完成后开放。帧号前的“约”表示临时估算。" TextWrapping="Wrap" Margin="0,0,0,12"/>
       <TextBlock Text="选择帧" FontWeight="SemiBold"/>
       <TextBlock Text="单击缩略图预览并设置范围起点，不改变勾选。双击或右上角勾选框增减这一帧，保留其他选择；勾选框不跳转预览。Ctrl 单击离散增减；Shift 单击从起点连续选择；Ctrl+Shift 单击追加范围。滚动和左右键预览不移动起点，Shift 连选保留原起点。时间轴上的“取消选中”清空勾选并保留预览。" TextWrapping="Wrap" Margin="0,4,0,12"/>
       <TextBlock Text="播放与定位" FontWeight="SemiBold"/>
       <TextBlock Text="播放栏提供首尾、前后 1 秒 / 5 秒、逐帧和播放 / 暂停。左右键沿用最近点击的 1 帧 / 1 秒 / 5 秒按钮步长；六个步进按钮支持按住连续移动。逐帧开关仍可手动切换，按秒模式下 Shift+左右键可按 5 秒移动。拖动进度条会持续更新画面。左右键、播放和拖动只改变预览，不改变勾选或范围起点，多选后不会跳回第一张。" TextWrapping="Wrap" Margin="0,4,0,12"/>
       <TextBlock Text="预览缩放" FontWeight="SemiBold"/>
       <TextBlock Text="右下角放大、缩小或在预览区按 Ctrl＋鼠标滚轮，可在适应窗口的 0.25—8 倍间缩放。放大后按住左键拖动画面；点击“适应”重置倍率和位置。切换帧保留倍率，打开新文件恢复适应。窗口右上角可最大化／还原，也可拖动窗口边缘调整大小或双击顶部计时区域。" TextWrapping="Wrap" Margin="0,4,0,12"/>
       <TextBlock Text="快捷键与导出" FontWeight="SemiBold"/>
       <TextBlock Text="预览或时间轴内：空格播放 / 暂停；Ctrl+Enter 增减当前帧；Ctrl+A 全选；Ctrl+Shift+A 清空；Home / End 定位首尾。输入框保留原有键盘行为。" TextWrapping="Wrap" Margin="0,4,0,8"/>
       <TextBlock Text="在右侧选择 PNG、MP4 或 GIF 后导出。PNG 每帧一张；MP4/GIF 只输出合成媒体与帧清单，不保留中间图片，且不含音频。完成后可打开导出文件或目录。左上数字是帧号，橙框表示当前预览，勾选和蓝底表示导出选择。" TextWrapping="Wrap"/>
       <TextBlock Text="帧编辑" FontWeight="SemiBold" Margin="0,12,0,4"/>
       <TextBlock Text="移除重复作用于整个时间轴，按原尺寸像素比较，100% 须完全相同，保留每组首帧。Delete 删除选中；Ctrl+Z 撤销，Ctrl+Y 重做。删除或减少帧数会缩短时长，操作和撤销后需重新选帧；原文件保留。编辑后视频预览及合成针对画面，不含音频。当前帧在可见范围内保持原位置，走到左右边缘后才滚动跟随。" TextWrapping="Wrap"/>

      </StackPanel></ScrollViewer>
     </Border>
    </Popup>
   </StackPanel>
   <TextBlock x:Name="FileLabel" Text="未打开媒体" TextTrimming="CharacterEllipsis" FontSize="12" Opacity="0.7"/>
    </StackPanel>
    <Border Grid.Row="1" Background="#0D64748B" BorderBrush="#2864748B" BorderThickness="1" CornerRadius="8" Padding="10">
    <DockPanel LastChildFill="True">
     <StackPanel DockPanel.Dock="Top">

      <TextBlock Text="导出选中帧" FontSize="16" FontWeight="SemiBold"/>
      <DockPanel Margin="0,8,0,0">
       <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
        <Button x:Name="AllButton" Content="全选" Click="All_Click" Padding="6,2" MinHeight="24" FontSize="11"/>
        <Button x:Name="ClearButton" Content="清空" Click="Clear_Click" Padding="6,2" MinHeight="24" FontSize="11" Margin="4,0,0,0" ToolTip="取消全部选中，不改变预览位置"/>
       </WrapPanel>
       <TextBlock x:Name="SelectionLabel" Text="已选 0 帧" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
      </DockPanel>
      <TextBlock x:Name="SelectionSummary" Text="" TextWrapping="Wrap" MaxHeight="30" FontSize="11" Opacity="0.75" Margin="0,4,0,8"/>
     </StackPanel>
     <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
      <Button x:Name="ExportButton" Content="导出" Click="ExportSelected_Click" Background="#2563EB" Foreground="White" BorderBrush="#2563EB" FontWeight="SemiBold" MinHeight="36" Margin="0,4,0,0" IsEnabled="False"/>
      <Button x:Name="OutputFileButton" Content="打开导出文件" Click="OutputFile_Click" Visibility="Collapsed" Margin="0,4,0,0"/>
      <Button x:Name="OutputButton" Content="打开导出目录" Click="Output_Click" Visibility="Collapsed" Margin="0,4,0,0"/>
     </StackPanel>
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
      <TextBlock Text="导出格式" FontSize="12" Margin="0,0,0,5"/>
      <ComboBox x:Name="ExportFormat" SelectedIndex="0" MinHeight="30" SelectionChanged="ExportFormat_Changed">
       <ComboBoxItem Content="图片 · PNG" Tag="png"/><ComboBoxItem Content="视频 · MP4" Tag="mp4"/><ComboBoxItem Content="动图 · GIF" Tag="gif"/>
      </ComboBox>
      <StackPanel x:Name="RatePanel" Margin="0,10,0,0" Visibility="Collapsed">
       <DockPanel><TextBlock Text="合成帧率" VerticalAlignment="Center"/>
        <TextBox x:Name="ExportFps" Text="10" Width="54" MinHeight="28" HorizontalContentAlignment="Right" Margin="6,0" ToolTip="1—60 帧/秒，允许小数；按时间顺序合成，不含音频"/>
        <TextBlock Text="帧/秒" VerticalAlignment="Center"/>
       </DockPanel>
      </StackPanel>
      <DockPanel Margin="0,10,0,5">
       <Button DockPanel.Dock="Right" Content="更改…" Click="OutputFolder_Click" Padding="6,1" MinHeight="24"/>
       <TextBlock Text="导出位置" FontSize="12" VerticalAlignment="Center"/>
      </DockPanel>
      <TextBox x:Name="OutputRoot" TextWrapping="Wrap" MinHeight="48" VerticalScrollBarVisibility="Auto" ToolTip="首次默认源文件旁的 Captura-exports；成功设置后记住该位置"/>



      <Expander Header="范围选择" Margin="0,12,0,0">
       <StackPanel Margin="0,8,0,0">
        <Button x:Name="RangeStartButton" Content="以当前帧为起点" Click="RangeStart_Click"/>
        <Button x:Name="RangeEndButton" Content="添加到当前帧的范围" Click="RangeEnd_Click" Margin="0,6,0,0"/>
       </StackPanel>
      </Expander>
      </StackPanel>
     </ScrollViewer>
    </DockPanel>
   </Border>
   </Grid>
  </Grid>
  <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="#2864748B"/>
  <Grid Grid.Row="2" Margin="0,6,0,0">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,6">
    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
     <Button x:Name="ClearTimelineButton" Content="取消选中" Click="Clear_Click" Style="{StaticResource FrameEditButton}" IsEnabled="False" ToolTip="取消全部选中，保留预览位置"/>
     <Button x:Name="DeleteFramesButton" Content="删除选中" Click="DeleteFrames_Click" Style="{StaticResource FrameEditButton}" IsEnabled="False" ToolTip="删除所选帧（Delete），至少保留一帧；可撤销"/>
     <Button x:Name="ReduceFramesButton" Content="减少帧数" Click="ReduceFrames_Click" Style="{StaticResource FrameEditButton}" IsEnabled="False"/>
     <Button x:Name="UndoEditButton" Content="撤销" Click="UndoEdit_Click" Style="{StaticResource FrameEditButton}" IsEnabled="False" ToolTip="撤销帧编辑（Ctrl+Z）"/>
     <Button x:Name="RedoEditButton" Content="重做" Click="RedoEdit_Click" Style="{StaticResource FrameEditButton}" IsEnabled="False" ToolTip="重做帧编辑（Ctrl+Y）"/>
     <Popup x:Name="ReduceFramesPopup" PlacementTarget="{Binding ElementName=ReduceFramesButton}" Placement="Top" StaysOpen="False" AllowsTransparency="True">
      <Border Background="{DynamicResource WindowBackground}" BorderBrush="#8064748B" BorderThickness="1" CornerRadius="6" Padding="14" Width="290">
       <StackPanel>
        <TextBlock Text="减少帧数" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/>
        <StackPanel Orientation="Horizontal"><TextBlock Text="每" VerticalAlignment="Center"/><TextBox x:Name="ReduceInterval" Text="2" Width="52" Margin="8,0" HorizontalContentAlignment="Right"/><TextBlock Text="帧保留 1 帧" VerticalAlignment="Center"/></StackPanel>
        <TextBlock x:Name="ReduceHint" Text="作用于整个时间轴，保留每组首帧；可撤销。" TextWrapping="Wrap" FontSize="11" Margin="0,10"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="应用" Click="ReduceApply_Click" Style="{StaticResource FrameEditButton}"/><Button Content="取消" Click="ReduceCancel_Click" Style="{StaticResource FrameEditButton}"/></StackPanel>
       </StackPanel>
      </Border>
     </Popup>
    </StackPanel>
    <TextBlock DockPanel.Dock="Left" Text="帧时间轴" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
     <TextBlock Text="移除重复：相似度" FontSize="11" VerticalAlignment="Center"/>
     <TextBox x:Name="SimilarityInput" Text="100" Width="48" Height="24" FontSize="11" MaxLength="5" Margin="5,0,2,0" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" ToolTip="0.1—100%；100% 为原尺寸像素完全相同，保留每组首帧"/>
     <TextBlock Text="%" FontSize="11" VerticalAlignment="Center"/>
     <Button x:Name="DuplicatesApply" Content="应用" Click="DuplicatesApply_Click" Style="{StaticResource FrameEditButton}" IsEnabled="False"/>
     <Button x:Name="DuplicatesCancel" Content="取消" Click="DuplicatesCancel_Click" Style="{StaticResource FrameEditButton}" IsEnabled="False"/>
    </StackPanel>
   </DockPanel>
   <ListBox Grid.Row="1" x:Name="FrameStrip" SelectionMode="Extended" SelectionChanged="FrameStrip_SelectionChanged" IsTextSearchEnabled="False" BorderThickness="0" Background="Transparent"
            ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
            VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.CacheLength="1" VirtualizingPanel.ScrollUnit="Item"
            PreviewMouseLeftButtonDown="FrameStrip_MouseDown" PreviewMouseWheel="FrameStrip_MouseWheel" ScrollViewer.ScrollChanged="FrameStrip_ScrollChanged">
    <ListBox.Template><ControlTemplate TargetType="ListBox">
     <ScrollViewer Focusable="False" CanContentScroll="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="0">
      <ItemsPresenter/>
     </ScrollViewer>
    </ControlTemplate></ListBox.Template>
    <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
    <ListBox.ItemContainerStyle>
     <Style TargetType="ListBoxItem">
      <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=OneWay}"/>
      <Setter Property="Width" Value="117"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,4,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Top"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></ControlTemplate></Setter.Value></Setter>
     </Style>
    </ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate>
     <DataTemplate>
      <Border x:Name="TileBorder" BorderThickness="2" CornerRadius="5" Padding="4" BorderBrush="#2864748B" Background="{DynamicResource WindowBackground}" ToolTip="{Binding Label}">
       <Grid>
        <Grid.RowDefinitions><RowDefinition Height="57"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="#111827" CornerRadius="3"><Grid>
         <TextBlock Text="{Binding ThumbnailHint}" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
         <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
        </Grid></Border>
        <Border x:Name="CurrentBadge" Background="#F59E0B" CornerRadius="3" HorizontalAlignment="Left" VerticalAlignment="Bottom" Visibility="Collapsed" Padding="5,1">
         <TextBlock Text="查看中" Foreground="#111827" FontSize="10"/>
        </Border>
        <Border Background="#D9111827" CornerRadius="3" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="5,1">
         <TextBlock Text="{Binding Number}" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
        </Border>
        <Border Background="#E6FFFFFF" CornerRadius="3" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="3">
         <CheckBox IsEnabled="{Binding CanSelectFrames, RelativeSource={RelativeSource AncestorType=UserControl}}" IsChecked="{Binding IsSelected, Mode=OneWay}" Click="TileCheck_Click" Margin="0" Foreground="#111827"
                   AutomationProperties.Name="{Binding Number, StringFormat=选择第 {0} 帧}" ToolTip="勾选可增减单帧，并保留其他选择"/>
        </Border>
        <TextBlock Grid.Row="1" Text="{Binding Time}" FontSize="10" Opacity="0.7" Margin="0,6,0,0"/>
       </Grid>
      </Border>
      <DataTemplate.Triggers>
       <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="TileBorder" Property="Background" Value="#243B82F6"/><Setter TargetName="TileBorder" Property="BorderBrush" Value="#3B82F6"/></DataTrigger>
       <DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter TargetName="CurrentBadge" Property="Visibility" Value="Visible"/><Setter TargetName="TileBorder" Property="BorderBrush" Value="#F59E0B"/></DataTrigger>
      </DataTemplate.Triggers>
     </DataTemplate>
    </ListBox.ItemTemplate>
   </ListBox>
  </Grid>
  <Grid Grid.Row="3" Margin="0,8,0,0">
   <Grid.Style><Style TargetType="Grid"><Style.Triggers>
    <MultiDataTrigger><MultiDataTrigger.Conditions>
     <Condition Binding="{Binding Text, ElementName=Status}" Value=""/>
     <Condition Binding="{Binding Visibility, ElementName=CancelButton}" Value="Collapsed"/>
    </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed"/></MultiDataTrigger>
   </Style.Triggers></Style></Grid.Style>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="Status" Text="" TextWrapping="Wrap" MaxHeight="32" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" FontSize="11" Margin="0,4,0,0"/>
   <Button x:Name="CancelButton" Grid.Column="1" Content="取消处理" Click="Cancel_Click" Visibility="Collapsed" Margin="10,0,0,0" VerticalAlignment="Top"/>
  </Grid>
 </Grid>
</UserControl>
